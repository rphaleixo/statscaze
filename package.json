{
  "name": "statscaze",
  "version": "1.0.0",
  "private": true,
  "description": "Coleta e análise de performance de vídeos do YouTube (Cazé TV), rodando como Cloudflare Worker + D1.",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 execute statscaze --local --file=migrations/0001_init.sql",
    "db:migrate:remote": "wrangler d1 execute statscaze --remote --file=migrations/0001_init.sql"
  },
  "devDependencies": {
    "wrangler": "^3.90.0"
  }
}
